diff --git a/initial/src/main/java/shop/Pagination.java b/final/src/main/java/shop/Pagination.java
index e5466b7..f9ff219 100644
--- a/initial/src/main/java/shop/Pagination.java
+++ b/final/src/main/java/shop/Pagination.java
@@ -21,10 +21,11 @@ public final class Pagination {
         if (pageSize < 1) {
             throw new IllegalArgumentException("pageSize must be >= 1");
         }
-        int start = page * pageSize;
-        if (start >= items.size()) {
+        long startLong = (long) (page - 1) * pageSize;
+        if (startLong >= items.size()) {
             return List.of();
         }
+        int start = (int) startLong;
         int end = Math.min(start + pageSize, items.size());
         return List.copyOf(items.subList(start, end));
     }
